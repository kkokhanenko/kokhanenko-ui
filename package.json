{
  "name": "@kokhanenko/ui",
  "version": "0.1.0",
  "description": "Modular Vue 3 UI components and application shell",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css",
    "./dist/foundation.js",
    "./dist/foundation-*.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/types/foundation/index.d.ts",
      "import": "./dist/foundation.js"
    },
    "./foundation.css": "./dist/foundation.css",
    "./button": {
      "types": "./dist/types/controls/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./select": {
      "types": "./dist/types/controls/select/index.d.ts",
      "import": "./dist/select.js"
    },
    "./toggle": {
      "types": "./dist/types/controls/toggle/index.d.ts",
      "import": "./dist/toggle.js"
    },
    "./tabs": {
      "types": "./dist/types/controls/tabs/index.d.ts",
      "import": "./dist/tabs.js"
    },
    "./column-picker": {
      "types": "./dist/types/data/column-picker/index.d.ts",
      "import": "./dist/column-picker.js"
    },
    "./data-table": {
      "types": "./dist/types/data/data-table/index.d.ts",
      "import": "./dist/data-table.js"
    },
    "./pagination": {
      "types": "./dist/types/data/pagination/index.d.ts",
      "import": "./dist/pagination.js"
    },
    "./table-toolbar": {
      "types": "./dist/types/data/table-toolbar/index.d.ts",
      "import": "./dist/table-toolbar.js"
    },
    "./table-filters": {
      "types": "./dist/types/data/table-filters/index.d.ts",
      "import": "./dist/table-filters.js"
    },
    "./table-view-toggle": {
      "types": "./dist/types/data/table-view-toggle/index.d.ts",
      "import": "./dist/table-view-toggle.js"
    },
    "./notice": {
      "types": "./dist/types/feedback/notice/index.d.ts",
      "import": "./dist/notice.js"
    },
    "./tooltip": {
      "types": "./dist/types/feedback/tooltip/index.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./action-menu": {
      "types": "./dist/types/overlays/action-menu/index.d.ts",
      "import": "./dist/action-menu.js"
    },
    "./modal": {
      "types": "./dist/types/overlays/modal/index.d.ts",
      "import": "./dist/modal.js"
    },
    "./app-shell": {
      "types": "./dist/types/shell/app-shell/index.d.ts",
      "import": "./dist/app-shell.js"
    },
    "./preferences": {
      "types": "./dist/types/preferences/index.d.ts",
      "import": "./dist/preferences.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.14.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vitest": "5.0.0",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
